import sys
import subprocess
import shlex
import hashlib
from pathlib import Path
from datetime import datetime

CLEARX_DIR = Path.home() / ".local" / "state" / "clearx"
LATEST_DIR = CLEARX_DIR / "latest"
MAX_HISTORY = 5
SCRIPT_PATH = Path(__file__).resolve()
START_MARKER = "# clearx-hook-start"
END_MARKER = "# clearx-hook-end"

def get_command_name(command):
    try:
        return Path(shlex.split(command)[0]).name
    except (ValueError, IndexError):
        return ""

def save_command(command):
    command = command.strip()
    if not command:
        return False
    command_name = get_command_name(command)
    if not command_name or command_name == "clearx":
        return False
    CLEARX_DIR.mkdir(parents=True, exist_ok=True)
    LATEST_DIR.mkdir(parents=True, exist_ok=True)
    filename = datetime.now().strftime("%Y%m%d%H%M%S%f")
    filepath = CLEARX_DIR / f"{filename}.cmd"
    filepath.write_text(command + "\n", encoding="utf-8")
    key = hashlib.sha256(
        command_name.encode("utf-8")
    ).hexdigest()
    latest_file = LATEST_DIR / f"{key}.cmd"
    latest_file.write_text(command + "\n", encoding="utf-8")
    files = sorted(
        CLEARX_DIR.glob("*.cmd"),
        reverse=True
    )
    for old_file in files[MAX_HISTORY:]:
        old_file.unlink()
    return True

def read_input():
    count = sum(save_command(command) for command in sys.stdin)
    print(f"{count}件のコマンドを保存しました")

def show_history():
    CLEARX_DIR.mkdir(parents=True, exist_ok=True)
    subprocess.run(["clear"], check=False)
    files = sorted(
        CLEARX_DIR.glob("*.cmd"),
        reverse=True
    )
    for file in reversed(files[:MAX_HISTORY]):
        print(f"$ {file.read_text(encoding='utf-8').strip()}")

def search_history(command_name):
    LATEST_DIR.mkdir(parents=True,exist_ok=True)
    key = hashlib.sha256(command_name.encode("utf-8")).hexdigest()
    latest_file = LATEST_DIR / f"{key}.cmd"
    subprocess.run(["clear"],check=False)

    if not latest_file.exists():
        print(f"{command_name}の正常終了した履歴はありません")
        return
    print(f"$ {latest_file.read_text(encording='utf-8').strip()}")

def install():
    bashrc = Path.home() / ".bashrc"
    content = bashrc.read_text(encoding="utf-8") if bashrc.exists() else ""
    if START_MARKER in content:
        print("clearx is already installed.")
        return
    script = shlex.quote(str(SCRIPT_PATH))
    hook = f"""
{START_MARKER}
__clearx_record() {{
    local status=$?
    local cmd
    cmd=$(fc -ln -1 2>/dev/null)
    python3 {script} --record "$status" "$cmd"
}}

if declare -p PROMPT_COMMAND 2>/dev/null | grep -q '^declare -a'; then
    PROMPT_COMMAND=(__clearx_record "${{PROMPT_COMMAND[@]}}")
else
    PROMPT_COMMAND="__clearx_record${{PROMPT_COMMAND:+; $PROMPT_COMMAND}}"
fi
{END_MARKER}
"""
    with bashrc.open("a", encoding="utf-8") as file:
        file.write(hook)

    CLEARX_DIR.mkdir(parents=True, exist_ok=True)

    print("clearx installed successfully.")
    print("Run: source ~/.bashrc")

def uninstall():
    bashrc = Path.home() / ".bashrc"
    if not bashrc.exists():
        print(".bashrc not found.")
        return
    content = bashrc.read_text(encoding="utf-8")
    start = content.find(START_MARKER)
    end = content.find(END_MARKER)
    if start == -1 or end == -1:
        print("clearx is not installed.")
        return
    end += len(END_MARKER)
    content = content[:start] + content[end:]
    bashrc.write_text(content, encoding="utf-8")
    print("clearx uninstalled.")
    print("Restart your terminal to apply changes.")

def main():
    args = sys.argv[1:]
    if not args:
        show_history()
    elif args[0] == "--input":
        read_input()
    elif args[0] == "--record":
        if len(args) < 3:
            sys.exit(1)
        status = int(args[1])
        command = args[2]
        if status == 0:
            save_command(command)
    elif args[0] == "--install":
        install()
    elif args[0] == "--uninstall":
        uninstall()
    else:
        search_history(args[0])
if __name__ == "__main__":
    main()
